background = #111418
foreground = #e1e2e8
cursor-color = #a3c9fe
cursor-text = #00315b
selection-background = #3c4758
selection-foreground = #d7e3f8

split-divider-color = #a3c9fe

custom-shader = shaders/cursor_warp.glsl

shell-integration = "zsh"

font-family = "Iosevka NF"

copy-on-select = true

keybind = ctrl+shift+k=scroll_page_up
keybind = ctrl+shift+j=scroll_page_down

keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+s=new_split:down
keybind = ctrl+shift+w=close_surface

keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down

keybind = alt+h=unbind
keybind = alt+l=unbind
keybind = alt+k=unbind
keybind = alt+j=unbind

adjust-cell-width = 0
adjust-cell-height = 0

window-padding-y = 0,0
window-padding-x = 0,0

shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = true
