# Colors
set default-bg "#101418"
set default-fg "#e0e2e8"

set statusbar-bg "#3b4857"
set statusbar-fg "#d6e4f7"

set inputbar-bg "#514060"
set inputbar-fg "#f1dbff"

set highlight-color "#154974"
set highlight-active-color "#9ecafc"

# Window settings
set font "Iosevka NF"
set window-height 1029
set window-width 973
# set show-scrollbar "true"
set selection-clipboard clipboard

# Keymaps
map K zoom in
map J zoom out
map H navigate previous
map L navigate next
