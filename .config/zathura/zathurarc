# Colors
set default-bg "#101417"
set default-fg "#e0e3e8"

set statusbar-bg "#384956"
set statusbar-fg "#d3e5f5"

set inputbar-bg "#4d4162"
set inputbar-fg "#ebddff"

set highlight-color "#004b70"
set highlight-active-color "#96cdf8"

# Window settings
set font "Iosevka NF"
set window-height 1029
set window-width 973
# set show-scrollbar "true"
set selection-clipboard clipboard

# Keymaps
map K zoom in
map J zoom out
map H navigate previous
map L navigate next
