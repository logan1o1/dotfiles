# Colors
set default-bg "#101417"
set default-fg "#dfe3e8"

set statusbar-bg "#384956"
set statusbar-fg "#d3e5f5"

set inputbar-bg "#4b4163"
set inputbar-fg "#e9ddff"

set highlight-color "#004c6e"
set highlight-active-color "#94cdf7"

# Window settings
set font "Iosevka NF"
set window-height 1029
set window-width 973
# set show-scrollbar "true"
set selection-clipboard clipboard

# Keymaps
map K zoom in
map J zoom out
map H navigate previous
map L navigate next
