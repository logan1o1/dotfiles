# Colors
set default-bg "#111318"
set default-fg "#e2e2e9"

set statusbar-bg "#3e4759"
set statusbar-fg "#dae2f9"

set inputbar-bg "#573e5c"
set inputbar-fg "#fad8fd"

set highlight-color "#284777"
set highlight-active-color "#aac7ff"

# Window settings
set font "Iosevka NF"
set window-height 1029
set window-width 973
# set show-scrollbar "true"
set selection-clipboard clipboard

# Keymaps
map K zoom in
map J zoom out
map H navigate previous
map L navigate next
