# Colors
set default-bg "#111318"
set default-fg "#e2e2e9"

set statusbar-bg "#3f4759"
set statusbar-fg "#dbe2f9"

set inputbar-bg "#583e5b"
set inputbar-fg "#fbd7fc"

set highlight-color "#2b4678"
set highlight-active-color "#adc6ff"

# Window settings
set font "Iosevka NF"
set window-height 1029
set window-width 973
# set show-scrollbar "true"
set selection-clipboard clipboard

# Keymaps
map K zoom in
map J zoom out
map H navigate previous
map L navigate next
