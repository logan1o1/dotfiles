# Colors
set default-bg "#111318"
set default-fg "#e2e2e9"

set statusbar-bg "#3f4759"
set statusbar-fg "#dbe2f9"

set inputbar-bg "#583e5b"
set inputbar-fg "#fbd7fc"

set highlight-color "#2b4678"
set highlight-active-color "#adc6ff"

# Window settings
set smooth-scroll "true"
set show-scrollbar "true"
set font "Iosevka NF"
# set window-height 1029
# set window-width 973
set selection-clipboard clipboard
set database "sqlite"
set adjust-open "best-fit"
set scroll-page-aware "true"
set scroll-full-overlap 0.01
set scroll-step 100
set pages-per-row 1
set render-loading "false"
set scroll-step 50

# Keymaps
map K zoom in
map J zoom out
map H navigate previous
map L navigate next
unmap f
map f toggle_fullscreen
map [fullscreen] f toggle_fullscreen
