# Colors
set default-bg "#0f1417"
set default-fg "#dfe3e7"

set statusbar-bg "#374955"
set statusbar-fg "#d2e5f4"

set inputbar-bg "#4a4263"
set inputbar-fg "#e8ddff"

set highlight-color "#004c6b"
set highlight-active-color "#92cef5"

# Window settings
set font "Iosevka NF"
set window-height 1029
set window-width 973
# set show-scrollbar "true"
set selection-clipboard clipboard

# Keymaps
map K zoom in
map J zoom out
map H navigate previous
map L navigate next
