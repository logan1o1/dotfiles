# Colors
set default-bg "{{background}}"
set default-fg "{{foreground}}"

set statusbar-bg "{{background}}"
set statusbar-fg "{{color1}}"

set inputbar-bg "{{color0}}"
set inputbar-fg "{{color1}}"

set highlight-color "{{color4}}"
set highlight-active-color "{{color6}}"

# Window settings
set font "Iosevka NF"
set window-height 1029
set window-width 973
# set show-scrollbar "true"
set selection-clipboard clipboard

# Keymaps
map K zoom in
map J zoom out
map H navigate previous
map L navigate next
